# Tinkerbell Backend Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Planable Configuration (Optional - uses mock data if not provided)
PLANABLE_ACCESS_TOKEN=your_planable_token_here
PLANABLE_BASE_URL=https://api.planable.io/v1

# Facebook Auto-Posting Configuration
FACEBOOK_PAGE_ID=your_facebook_page_id_here
AUTO_POST_ENABLED=true

# Image Configuration
MAX_UPLOAD_SIZE=10MB
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
GENERATE_IMAGES=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Application Settings
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080
